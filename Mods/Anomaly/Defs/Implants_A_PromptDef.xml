<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- FleshmassStomach -->
  <EchoColony.HediffAIPromptDef>
    <defName>Prompt_FleshmassStomach</defName>
    <targetHediff>FleshmassStomach</targetHediff>
    <customLabel>fleshmass stomach</customLabel>
    <functionalNote>cancerous semi-sentient organic stomach producing harsh acid that prevents food poisoning and gut worms at the cost of constant pain</functionalNote>
  </EchoColony.HediffAIPromptDef>

  <!-- FleshmassLung -->
